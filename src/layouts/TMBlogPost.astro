---
import '../styles/global.css'
import TMHeader from "../layouts/components/TMHeader.astro"
import TMFooter from "../layouts/components/TMFooter.astro"
const { frontmatter } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} — Techromancy</title>
  </head>
	<body class="flex min-h-screen flex-col antialiased bg-accent text-accent bg-[image:var(--site-bg)] bg-cover bg-center bg-fixed">
    <div class="fixed inset-0 -z-10 bg-[image:var(--site-bg)] bg-cover bg-center"></div>
    <TMHeader />
      <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10">
      <article class="prose"> <!--  article class is from tailwind/typography plugin -->
        <h1>{frontmatter.title}</h1>
        <p>Published on: {frontmatter.pubDate.toString().slice(0,10)}</p>
        <p>Written by: {frontmatter.author}</p>
        <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />
        <slot />
        <a href="/blog/">Back to articles</a>
      </article>
      </main>
    <TMFooter />
  </body>
</html>