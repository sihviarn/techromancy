---
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 bg-zinc-900/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl flex-col gap-2 px-4 py-8 text-sm text-zinc-400 sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} your.site</p>
    <div class="flex gap-4">
      <a href="https://github.com/yourname" class="hover:text-zinc-200">GitHub</a>
      <a href="/rss.xml" class="hover:text-zinc-200">RSS</a>
    </div>
  </div>
</footer>